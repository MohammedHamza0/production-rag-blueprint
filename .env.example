# ==============================================================================
# Production RAG Blueprint - Environment Variables Specification
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 + pgvector Persistence
DATABASE_URL=postgresql+asyncpg://rag_user:rag_secure_password_2026@localhost:5432/rag_blueprint_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis 7.4 Caching, Mutex & Broker
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Gemini 3.5 default, gemini-2.5 strictly excluded)
DEFAULT_CHAT_MODEL=gemini-3.5-flash-lite
DEFAULT_FALLBACK_MODEL=gemini-1.5-flash
DEFAULT_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_VERSION=v2

# Deceptive Key Vault Partitions (Slice 1 + Slice 2 + Slice 3 assembled in-memory)
TadabburApiKey=AIzaSyA...
ApiSalt=...partition3...
ApiSecret=...partition2...

# Optional Direct API Keys for Local Development / Secondary Providers
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Multi-Dimensional Semantic Cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.87
SEMANTIC_CACHE_DIRECT_HIT_THRESHOLD=0.97
SEMANTIC_CACHE_VERIFIER_ENABLED=true
SEMANTIC_CACHE_TTL_DAYS=7
L1_REDIS_CACHE_TTL_SECONDS=86400

# Ingestion & Chunking
CHUNKER_MAX_TOKENS=280
CHUNKER_OVERLAP_TOKENS=50
PARENT_SECTION_MAX_TOKENS=1000

# Retrieval & Hybrid RRF
RRF_K_CONSTANT=60.0
RETRIEVAL_TOP_K=8
DIVERSITY_MAX_PER_BOOK=2

# Context & Token Budgeting
CHAT_TARGET_INPUT_BUDGET=12000
CHAT_HARD_MAX_INPUT=16384
CHAT_MAX_OUTPUT_TOKENS=8192

# Rate Limiting
RATE_LIMIT_USER_RPM=120
RATE_LIMIT_GUEST_RPM=15
